{
  "name": "clearview",
  "displayName": "Clearview",
  "description": "A rich markdown editor for VS Code with live preview and editing",
  "version": "0.1.1",
  "publisher": "clearview",
  "repository": {
    "type": "git",
    "url": "https://github.com/abenke/clearview"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:clearview.openEditor",
    "onCommand:clearview.openEditorToSide"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "clearview.openEditor",
        "title": "Open Clearview Editor",
        "icon": "$(edit)"
      },
      {
        "command": "clearview.openEditorToSide",
        "title": "Open Clearview Editor to the Side",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == markdown",
          "command": "clearview.openEditorToSide",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceLangId == markdown",
          "command": "clearview.openEditor",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "clearview.openEditorToSide",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "resourceLangId == markdown"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}
